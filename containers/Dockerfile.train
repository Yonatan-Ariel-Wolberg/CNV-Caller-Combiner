# ==============================================================================
# Dockerfile: Dockerfile.train
# Description: Production-ready, security-hardened Docker container for CNV-Caller-Combiner
#              Machine Learning Triage (CatBoost, Optuna, Scikit-learn, Pysam).
# Base Image:  python:3.11-slim
# ==============================================================================

FROM python:3.12-slim

# Prevent interactive prompts during build
ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

# Metadata labels mapping to opencontainers specification
LABEL org.opencontainers.image.title="catboost-train" \
      org.opencontainers.image.description="ML model training, Bayesian tuning, and feature triage (CatBoost & Optuna) for germline CNV calling" \
      org.opencontainers.image.version="1.0.0" \
      software.version="1.0.0" \
      org.opencontainers.image.authors="Yonatan Wolberg" \
      org.opencontainers.image.licenses="BSD-3-Clause" \
      org.opencontainers.image.source="https://github.com/Yonatan-Ariel-Wolberg/CNV-Caller-Combiner"

# Install system runtime & build dependencies, upgrade OS packages to latest security patches
RUN apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends \
        build-essential \
        libz-dev \
        procps \
        ca-certificates \
    && pip install --no-cache-dir --upgrade pip "setuptools>=70.0.0" wheel \
    && pip install --no-cache-dir \
        "certifi>=2024.7.4" \
        "urllib3>=2.2.2" \
        "requests>=2.32.3" \
        "jinja2>=3.1.5" \
        "tornado>=6.4.2" \
        catboost==1.2.10 \
        optuna==5.0.0 \
        xgboost==2.1.4 \
        scikit-learn==1.6.1 \
        shap>=0.45.0 \
        imbalanced-learn>=0.12.0 \
        pandas>=2.2.0 \
        numpy>=1.26.0 \
        pysam>=0.22.0 \
        scipy>=1.13.0 \
        matplotlib>=3.8.0 \
    && apt-get purge -y --auto-remove build-essential libz-dev \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /root/.cache /tmp/* /var/tmp/* /usr/local/lib/python*/ensurepip

# Add non-root user for execution security (CIS Docker Benchmark 4.1)
RUN groupadd -g 10001 appuser \
    && useradd -u 10001 -g 10001 -m -s /bin/bash appuser \
    && mkdir -p /workspace \
    && chown -R 10001:10001 /workspace \
    && chmod 0777 /workspace

WORKDIR /workspace

# Switch to non-root user
USER 10001:10001

# Verify installation of all required modules
RUN python3 -c "import catboost, optuna, xgboost, sklearn, shap, imblearn, pandas, numpy, pysam, scipy, matplotlib; print('ML dependencies successfully verified!')"

CMD ["python3", "-c", "import catboost, optuna; print('CatBoost & Optuna ML environment ready')"]
