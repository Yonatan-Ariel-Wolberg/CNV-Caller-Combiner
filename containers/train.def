# ==============================================================================
# Apptainer/Singularity Definition File: train.def
# Description: Production-ready container recipe for CNV-Caller-Combiner
#              Machine Learning Triage (CatBoost, Optuna, Scikit-learn, Pysam).
# ==============================================================================

Bootstrap: docker
From: python:3.12-slim

%labels
    Author Yonatan Wolberg
    Version 1.0.0
    Description CatBoost & Optuna Machine Learning Triage Container for CNV-Caller-Combiner

%environment
    export LANG=C.UTF-8
    export LC_ALL=C.UTF-8
    export PYTHONUNBUFFERED=1
    export PYTHONDONTWRITEBYTECODE=1

%post
    apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        libz-dev \
        procps \
        ca-certificates \
        curl \
    && rm -rf /var/lib/apt/lists/*

    pip install --no-cache-dir --upgrade pip
    pip install --no-cache-dir \
        catboost==1.2.10 \
        optuna==5.0.0 \
        xgboost==2.1.4 \
        scikit-learn==1.6.1 \
        shap>=0.45.0 \
        imbalanced-learn>=0.12.0 \
        pandas>=2.2.0 \
        numpy>=1.26.0 \
        pysam>=0.22.0 \
        scipy>=1.13.0 \
        matplotlib>=3.8.0

    mkdir -p /workspace
    chmod 0777 /workspace

%test
    python3 -c "import catboost, optuna, xgboost, sklearn, shap, imblearn, pandas, numpy, pysam, scipy, matplotlib; print('CatBoost & Optuna ML environment verified!')"

%runscript
    exec python3 "$@"
