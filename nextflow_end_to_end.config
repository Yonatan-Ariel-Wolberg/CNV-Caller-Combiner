apptainer {
  enabled = true
  autoMounts = true
  cacheDir = "${projectDir}/.apptainer-cache"
}

docker {
  enabled = false
}

process {
  // Label-based container matching
  withLabel: 'survivor' {
    container = 'docker://quay.io/biocontainers/survivor:1.0.6--h6bb024c_0'
  }
  
  withLabel: 'bcftools' {
    container = 'docker://quay.io/biocontainers/bcftools:1.23.1--hb2cee57_0'
  }

  // Explicit configuration for exome-coverage processes
  withName: 'RUN_MOSDEPTH' {
    container = 'docker://quay.io/biocontainers/mosdepth:0.3.14--h05c3d44_0'
  }

  withName: 'BUILD_CONSENSUS' {
    container = 'docker://quay.io/biocontainers/bedtools:2.27.1--h077b44d_9'
  }

  withName: 'DOWNLOAD_ANNOTSV_DB' {
    executor = 'local'
  }

  withName: 'runAnnotSV' {
    container        = { params.annotsv_version.startsWith('3.5') ? 'docker://quay.io/biocontainers/annotsv:3.5.10--hdfd78af_0' : 'docker://quay.io/biocontainers/annotsv:3.4.6--py313hdfd78af_0' }
    containerOptions = { params.annotsv_db ? "-B ${params.annotsv_db}:${params.annotsv_db}" : "" }
  }
}
