#!/usr/bin/env nextflow
/**
 * Purpose: Global pipeline configuration file coordinating parameters, infrastructure settings, container runtime bindings, resource allocations, SLURM cluster profiles, and output tracing.
 * Author/Context: CNV-Caller-Combiner Nextflow Pipeline
 * Configuration Sections:
 *   - Helper Functions (path bind-mounting flags generation)
 *   - Global Fallback Parameters (merger, help, GATK gCNV, CANOES, XHMM, CNVkit, etc.)
 *   - Engine Settings (Apptainer, Singularity, SLURM executor settings)
 *   - Process Settings & Container Mappings (biocontainers for all tools)
 *   - Execution Profiles (small, medium, large, wits, wits_gpu)
 *   - Reporting (trace, timeline, report, DAG)
 *   - Pipeline Manifest (metadata, version)
 */

// Purpose:
//   This global configuration file coordinates all parameters, infrastructure settings,
//   container runtime bindings, resource allocations, cluster profiles, and output tracing
//   for the CNV-Caller-Combiner workflows.
//
// Infrastructure Support:
//   - Container Engines: Apptainer/Singularity container execution enabled by default.
//   - HPC Environment: Wits UI Linux HPC cluster integration (SLURM scheduler).
//   - GPU Acceleration: NVIDIA L4 GPU support via wits_gpu profile for Parabricks alignment.
//
// Key Configuration Scopes:
//   - helper functions (path bind-mounting)
//   - default parameters (GATK gCNV, CANOES, XHMM, CNVkit parameters)
//   - process containers & resource parameters (CPUs, Memory, limits)
//   - execution profiles (small, medium, large cohort sizing)
// =============================================================================
nextflow.enable.dsl=2


nextflow.telemetry.enabled = false

env {
    PYTENSOR_FLAGS = 'base_compiledir=./.pytensor'
}

// =====================================================================================
// HELPER FUNCTIONS
// =====================================================================================
// Converts a comma-separated list of host paths to Singularity/Apptainer bind-mount
// flags.  Example: '/a,/b /c' → ' -B /a -B /b /c'
// Used by the singularity, apptainer, and icav2-dragen container runOptions below.
def bindMountFlags(String paths) {
    paths ? paths.tokenize(',').collect { ' -B ' + it.trim() }.join('') : ''
}

// =====================================================================================
// GLOBAL FALLBACK PARAMETERS (Overwritten by JSON params files)
// =====================================================================================
params {
    merger = 'truvari' // Options: 'survivor' or 'truvari'
    // Centralized strict/global CLI params (keep pipeline-facing defaults here).
    help           = false
    workflow       = 'none'
    run_qc         = false
    outdir         = './results'
    test_size      = -1
    skip_gcnv_training = false
    skip_ml_training   = false
    skip_training      = false
    ml_pathway         = 'B' // Pathway B: CatBoost In Silico Prediction (Analytical Validity) -> AF Filtering (Clinical Utility)
    catboost_select_features = true
    catboost_n_features      = 12
    catboost_tune_hyperparameters = true
    catboost_n_trials        = 30
    catboost_eval_metric     = 'PRAUC'
    catboost_threshold       = 0.5
    // GATK gCNV defaults (moved from module-level params block).
    bin_length     = 0      // 0 = no binning for exome (each target interval is its own bin); use >0 for WGS
    padding        = 250    // 250 bp padding per GATK gCNV exome best practice
    scatter_count  = 5000   // SCATTER_CONTENT: max intervals per shard (used with INTERVAL_COUNT mode)
    is_wgs         = false  // Set to false indicating the analysis is exome sequencing
    // Comma-separated list of host filesystem paths to bind-mount into every container.
    // This is the easiest way to give the workflow access to your data directories.
    // Example (Wits cluster): '/dataB/aux,/dataG/ddd,/dataG/ddd-2023,/home/ywolberg'
    // Example (other users):  '/data/myproject,/scratch/myuser'
    // Each path becomes a '-B <path>' argument passed to Singularity/Apptainer.
    bind_paths     = ''
    // Extra raw arguments forwarded to the container runtime (Singularity/Apptainer).
    // Use bind_paths for simple directory mounts; use runOptions for advanced flags
    // not covered by bind_paths (e.g. '--no-home', '--writable-tmpfs').
    runOptions     = ''
    // ICAv2-DRAGEN defaults (overridden by params-icav2-dragen.json)
    maxUploadForks = 4
    uploadRetries  = 5
    // ICAv2 CLI container SIF image path or Docker Hub URI and credentials directory.
    // Set these in your params-file or local config before running the dragen workflow.
    icav2_container = 'docker://ywolberg/cnv-caller-combiner:icav2-cli'
    icav2_creds_dir = System.getProperty('user.home') + '/.icav2'
    // Custom Docker Hub container URIs for ML training and SeeNV visualization
    train_container = 'docker://ywolberg/cnv-caller-combiner:catboost-train'
    seenv_container = 'docker://ywolberg/cnv-caller-combiner:seenv-visualizer'
    // Batch-size defaults for CANOES and XHMM (medium-cohort values).
    // Overridden by the small/medium/large cohort-size profiles, or by a
    // params-file.  These global defaults ensure that a meaningful value is
    // always available even when no cohort-size profile is selected.
    canoes_batch_size = 100  // BAMs per bedtools multicov job (CANOES)
    xhmm_batch_size   = 50   // BAMs per GATK DepthOfCoverage job (XHMM)
    annotsv_version     = '3.5.10'
    annotsv_db          = "${projectDir}/annotsv_db/AnnotSV_annotations/share/AnnotSV"
    skip_annotation     = false
    cnvkit_gq_threshold = 1  // Minimum genotype quality (probe count) for filtering CNVkit calls
    truth_bed           = null
    probes              = null
    probes_bed          = null
    targets             = null
    map_file            = null

    // Quality Assessment (QC) workflow parameters
    input_dir           = "$launchDir"
    output_dir          = './qc_results'
    ref_genome          = null
    target_bed          = null
    mapq_threshold      = 20
    threads             = 4

    // Default rare filter parameters
    total_samples       = 90
    max_af              = 0.05

    // Post-consensus breakpoint refinement parameters
    run_refinement               = true
    refinement_max_flank         = 50000
    refinement_max_delta         = 25000
    refinement_focal_threshold   = 10000
    refinement_min_focal_delta   = 1000
    refinement_focal_slack_ratio = 1.0
    refinement_min_recip_overlap = 0.20

    // Headless IGV HTML report generation
    generate_igv_reports         = false

    // Quality score filtering and normalisation control
    skip_quality_filtering      = false
    skip_normalisation          = false
    skip_quality_normalisation  = false

    // Default quality filter profile: 'balanced' (default), 'high_precision', or 'max_sensitivity'
    filter_profile              = 'balanced'

    // =================================================================================
    // Centralized CNV Caller Quality Thresholds & Size Filters
    // When null (default), thresholds are dynamically derived from filter_profile.
    // Specifying an explicit value (e.g. --canoes_q_some_min 80) overrides the profile.
    // =================================================================================
    // CANOES quality & size thresholds
    canoes_q_some_min           = null
    canoes_min_size             = null

    // CLAMMS quality thresholds
    clamms_q_some_min           = null
    clamms_q_exact_del_min      = null
    clamms_q_exact_dup_min      = null

    // XHMM quality & size thresholds
    xhmm_sq_min                 = null
    xhmm_ndq_min                = null
    xhmm_eq_min                 = null
    xhmm_min_size               = null

    // CNVkit size and probe thresholds
    cnvkit_min_size             = null
    cnvkit_min_probes           = null

    // GATK gCNV quality thresholds
    gcnv_qs_del_min             = null
    gcnv_qs_dup_min             = null
    gcnv_single_interval_qs_min = null

    // DRAGEN Germline quality & size thresholds
    dragen_qual_min             = null
    dragen_min_bc               = null
    dragen_min_size             = null

    // ExomeDepth quality & size thresholds
    exomedepth_bf_min           = null
    exomedepth_min_size         = null
}

// =====================================================================================
// ENGINE SETTINGS
// =====================================================================================
// Singularity – legacy compatibility scope (disabled by default).
// The cache directory is resolved from the NXF_SINGULARITY_CACHEDIR environment
// variable so that all worker nodes share a single image store on a shared
// filesystem (e.g. /spaces/<project>/nxf_cache on the Wits HPC).  When the
// variable is unset the default falls back to $HOME/.singularity/cache.
singularity {
    enabled    = false
    autoMounts = true
    cacheDir   = System.getenv('NXF_SINGULARITY_CACHEDIR') ?: "$HOME/.singularity/cache"
    runOptions = "--cleanenv${bindMountFlags(params.bind_paths)}${params.runOptions ? ' ' + params.runOptions : ''}"
}

apptainer {
    enabled    = true
    autoMounts = true
    cacheDir   = System.getenv('NXF_SINGULARITY_CACHEDIR') ?: "$HOME/.apptainer/cache"
    runOptions = "--cleanenv${bindMountFlags(params.bind_paths)}${params.runOptions ? ' ' + params.runOptions : ''}"
}

executor {
    jobName        = { "${task.name.replaceAll(' ', '_').toUpperCase()}" }
    queueSize      = 500          // Allow up to 500 jobs queued at once for large cohorts
    submitRateLimit = '10/1sec'   // Limit job submission to 10 per second to avoid overwhelming scheduler
    pollInterval   = '30 sec'     // Reduce polling overhead for large runs
}

// =====================================================================================
// PROCESS SETTINGS & CONTAINERS
// =====================================================================================
process {       
    cache          = 'lenient'    
    stageInMode    = 'symlink'
    stageOutMode   = 'rsync'
    cpus           = { [4, (Runtime.runtime.availableProcessors() ?: 2)].min() }                    // Default CPUs for higher parallelism, capped at available host CPUs
    memory         = 16.GB                 // Adjusted memory for sample processing
    time           = 48.h                   // Increased time limit for longer processes
    maxForks       = 100                   // Support large cohorts; each withLabel block can override
    errorStrategy  = { task.exitStatus in [143,137,104,134,139] ? 'retry' : (task.attempt <= 2 ? 'retry' : 'finish') }
    maxRetries     = 2
    

    withLabel: 'xhmm' {
        container = 'docker://phelelani/nf-exomecnv:xhmm'
        memory    = 4.GB
        cpus      = 1
    }
    withLabel: 'gatk' {
        container      = 'docker://broadinstitute/gatk:4.6.2.0'
        memory         = 24.GB                  // Adjusted for GATK DepthOfCoverage + JVM off-heap headroom
        cpus           = 4
    }
    withLabel: 'picard' {
        container      = 'docker://quay.io/biocontainers/picard:3.4.0--hdfd78af_0'
        memory         = 16.GB                  // Adjusted for Picard
        cpus           = 4        
    }
    withLabel: 'canoes' {
        container = 'docker://phelelani/nf-exomecnv:canoes'
        memory    = 4.GB
        cpus      = 1
    }
    withLabel: 'canoes_R' {
        container = 'docker://phelelani/nf-exomecnv:canoes'
        memory    = 4.GB
        cpus      = 1
    }
    withLabel: 'R' {
        container = 'docker://phelelani/nf-exomecnv:canoes'
        memory    = 4.GB
        cpus      = 1
    }
    withLabel: 'exomedepth' {
        container = 'docker://quay.io/biocontainers/r-exomedepth:1.1.16--r43hfb3cda0_3'
        memory    = 8.GB
        cpus      = 2
    }
    withLabel: 'clamms_bedtools' {
        container = 'docker://phelelani/nf-exomecnv:clamms'
        memory    = 4.GB
        cpus      = 2
    }
    withLabel: 'bedtools' {
        container = 'docker://quay.io/biocontainers/bedtools:2.31.1--h13024bc_3'
        memory    = 2.GB
        cpus      = 1
    }
    withLabel: 'cnvkit' {
        container = 'docker://quay.io/biocontainers/cnvkit:0.9.12--pyhdfd78af_1'
        memory    = 4.GB
        cpus      = 2
    }
    withLabel: 'survivor' {
        container = 'docker://quay.io/biocontainers/survivor:1.0.6--h6bb024c_0'
        memory    = 2.GB
        cpus      = 1
    }
    withLabel: 'truvari' {
        container = 'docker://quay.io/biocontainers/truvari:5.4.0--pyhdfd78af_0'
        memory    = 2.GB
        cpus      = 1
    }
    withLabel: 'svaba' {
        container = 'docker://quay.io/biocontainers/svaba:1.2.0--h69ac913_1'
        memory    = 8.GB
        cpus      = 4
    }
    withLabel: 'pysam' {
        container = 'docker://quay.io/biocontainers/cnvkit:0.9.12--pyhdfd78af_1'
        memory    = 4.GB
        cpus      = 1
    }
    withLabel: 'feature_extraction' {
        // Reuse the cnvkit container: feature_extraction.py requires pysam,
        // pandas, numpy (all bundled in the cnvkit biocontainer).
        container = 'docker://quay.io/biocontainers/cnvkit:0.9.12--pyhdfd78af_1'
        memory    = 4.GB
        cpus      = 1
    }
    withLabel: 'train' {
        // Custom Docker Hub image containing CatBoost, Optuna, XGBoost, Scikit-learn, and Pysam.
        container = params.get('train_container', 'docker://ywolberg/cnv-caller-combiner:catboost-train')
        containerOptions = "-B /spaces/ywolberg:/spaces/ywolberg"
        memory    = 16.GB
        cpus      = 4
    }
    withLabel: 'bcftools' {
        container = 'docker://quay.io/biocontainers/bcftools:1.23.1--hb2cee57_0'
        memory    = 2.GB
        cpus      = 1
    }
    withLabel: 'mosdepth' {
        container = 'docker://quay.io/biocontainers/mosdepth:0.3.14--h05c3d44_0'
        memory    = 4.GB
        cpus      = 2
    }
    withName: '(FILTER_RARE_CNVS|filterRareCnvs)' {
        container = 'docker://quay.io/biocontainers/cnvkit:0.9.12--pyhdfd78af_1'
        memory    = 4.GB
        cpus      = 1
    }
    withName: '(ADD_ACMG_ANNOTATIONS|addACMGAnnotations)' {
        container = 'docker://quay.io/biocontainers/cnvkit:0.9.12--pyhdfd78af_1'
        memory    = 4.GB
        cpus      = 1
    }
    withName: '(STRATIFY_VCF_BY_ACMG|stratifyVcfByAcmg)' {
        container = 'docker://quay.io/biocontainers/cnvkit:0.9.12--pyhdfd78af_1'
        memory    = 4.GB
        cpus      = 1
    }
    withName: 'ANALYZE_CNV_QUALITY_METRICS' {
        container = 'docker://quay.io/biocontainers/cnvkit:0.9.12--pyhdfd78af_1'
        memory    = 4.GB
        cpus      = 1
    }
    withName: 'EVALUATE_ACMG_CSV' {
        container = 'docker://quay.io/biocontainers/cnvkit:0.9.12--pyhdfd78af_1'
        memory    = 4.GB
        cpus      = 1
    }
    withName: 'PLOT_EVALUATION_METRICS' {
        container = 'docker://quay.io/biocontainers/cnvkit:0.9.12--pyhdfd78af_1'
        memory    = 4.GB
        cpus      = 1
    }
    withName: '(EVALUATE_CALLER|EVALUATE_CALLER_COMP)' {
        container = 'docker://quay.io/biocontainers/cnvkit:0.9.12--pyhdfd78af_1'
        memory    = 4.GB
        cpus      = 1
    }
    withName: '(ASSESS_CALLSET_QUALITY_METRICS|COMPILE_ALL_STAGES_QUALITY_REPORT|GENERATE_ATTRITION_FUNNEL)' {
        container = 'docker://quay.io/biocontainers/cnvkit:0.9.12--pyhdfd78af_1'
        memory    = 4.GB
        cpus      = 1
    }
    withName: 'DOWNLOAD_ANNOTSV_DB' {
        executor         = 'local'
        memory           = 4.GB
        cpus             = 1
    }
    withName: '(RUN_ANNOTSV|runAnnotSV)' {
        container        = { (params.get('annotsv_version', '3.5.10') ?: '3.5.10').startsWith('3.5') ? 'docker://quay.io/biocontainers/annotsv:3.5.10--hdfd78af_0' : 'docker://quay.io/biocontainers/annotsv:3.4.6--py313hdfd78af_0' }
        containerOptions = { params.get('annotsv_db', false) ? "--env LC_ALL=C --env LANG=C -B ${params.annotsv_db}:/usr/local/share/AnnotSV" : "--env LC_ALL=C --env LANG=C -B ${projectDir}/annotsv_db/AnnotSV_annotations/share/AnnotSV:/usr/local/share/AnnotSV" }
        memory           = 8.GB
        cpus             = 1
    }
    withLabel: 'icav2_dragen' {
        // Set params.icav2_container to your Docker Hub URI or local Singularity SIF image path.
        // Default: docker://ywolberg/cnv-caller-combiner:icav2-cli
        container   = params.get('icav2_container', 'docker://ywolberg/cnv-caller-combiner:icav2-cli')
        // Mount local ICA credentials (~/.icav2) into the container.
        // Override params.icav2_creds_dir if your credentials live elsewhere.
        // bind_paths and runOptions are also forwarded so that user data directories
        // are accessible inside the DRAGEN container.
        containerOptions = "--cleanenv${bindMountFlags(params.bind_paths)}${params.runOptions ? ' ' + params.runOptions : ''} -B ${params.get('icav2_creds_dir', System.getProperty('user.home') + '/.icav2')}:/root/.icav2"
        maxRetries  = 5                 // Increased retries for connection stability
        // Exit status 100 signals a critical unrecoverable error (e.g. ICA auth failure) — terminate immediately
        errorStrategy = { task.exitStatus == 100 ? 'terminate' : 'retry' }
    }

    // Quality Assessment (QC) container and resource settings
    withLabel: 'samtools' {
        container = 'docker://quay.io/biocontainers/samtools:1.21--h96c455f_1'
        cpus      = { params.threads ?: 4 }
    }
    withLabel: 'qualimap' {
        container = 'docker://quay.io/biocontainers/qualimap:2.3--hdfd78af_0'
        memory    = 8.GB
        cpus      = 4
    }
    withLabel: 'multiqc' {
        container = 'docker://quay.io/biocontainers/multiqc:1.14--pyhdfd78af_0'
        memory    = 4.GB
        cpus      = 2
    }
    withLabel: 'igv_reports' {
        container = 'docker://quay.io/biocontainers/igv-reports:1.16.0--pyh7e72e81_0'
        memory    = 4.GB
        cpus      = 2
    }
    withLabel: 'seenv' {
        // Custom Docker Hub image containing SeeNV exome CNV visual curation & dependencies
        container = params.get('seenv_container', 'docker://ywolberg/cnv-caller-combiner:seenv-visualizer')
        memory    = 8.GB
        cpus      = 2
    }
    withLabel: 'seenv_db' {
        // Custom Docker Hub image containing SeeNV & bedtools for exonic coverage matrix calculations
        container = params.get('seenv_container', 'docker://ywolberg/cnv-caller-combiner:seenv-visualizer')
        memory    = 8.GB
        cpus      = 2
    }

    // ---------------------------------------------------------------------------------
    // Dynamic Resource Constraints (For GCNV/CNVkit)
    // ---------------------------------------------------------------------------------
    withLabel: 'large_mem' {
        memory = 64.GB
        cpus   = 8
    }
    withLabel: 'gpu_or_high_cpu' {
        memory = 32.GB
        cpus   = 16
    }
}

// =====================================================================================
// PROFILES
// =====================================================================================
profiles {
    apptainer {
        apptainer.enabled    = true
        singularity.enabled  = false
        docker.enabled       = false
    }
    singularity {
        singularity.enabled  = true
        apptainer.enabled    = false
        docker.enabled       = false
    }
    docker {
        docker.enabled       = true
        singularity.enabled  = false
        apptainer.enabled    = false
    }
    // wits – University of the Witwatersrand (Wits) UI Linux HPC cluster
    // Uses the SLURM scheduler.  Combine with a cohort-size profile:
    //   nextflow run main.nf -profile wits,small  -params-file params/general/params-canoes.json
    //
    // Before running, set NXF_SINGULARITY_CACHEDIR to a path on a shared volume
    // that is accessible by all worker nodes, e.g.:
    //   export NXF_SINGULARITY_CACHEDIR=/spaces/<project>/nxf_cache
    //
    // This profile targets CPU-only worker nodes.  GPU-accelerated processes
    // (e.g. Parabricks) are not submitted because no --gres=gpu clusterOptions
    // are set here; add a dedicated GPU profile if GPU nodes become available.
    wits {
        apptainer.enabled        = true
        apptainer.autoMounts     = true
        apptainer.runOptions     = '-B /dataG,/spaces,/dataB'
        executor.name            = 'slurm'
        executor.queueSize       = 250
        executor.submitRateLimit = '5/1sec'
        executor.pollInterval    = '30 sec'
        executor.exitReadTimeout = '30 min'
        process {
            queue          = 'batch'
            cpus           = 4        // Default CPUs per SLURM job
            memory         = '16 GB'  // Default memory per SLURM job
            time           = '72h'    // Default wall-clock limit per SLURM job
            clusterOptions = '--nodes=1 --exclude=n18,n26,n28'
        }
        // Singularity/Apptainer cache on a shared /spaces volume so that images
        // are downloaded once and reused by all worker nodes.
        singularity.cacheDir = System.getenv('NXF_SINGULARITY_CACHEDIR') ?: "$HOME/.singularity/cache"
        apptainer.cacheDir   = System.getenv('NXF_SINGULARITY_CACHEDIR') ?: "$HOME/.apptainer/cache"
    }

    // ---------------------------------------------------------------------------------
    // QUALITY SCORE FILTER PROFILES (from CNV_Caller_Filtering_Guide-YAW.docx)
    // Select using e.g. -profile balanced (default), -profile high_precision, or -profile max_sensitivity
    // Can also be configured via CLI parameter: --filter_profile <name>
    // For detailed biological rationales and tool default comparisons, see:
    // docs/PARAMETER_ADJUSTMENTS.md
    // ---------------------------------------------------------------------------------
    balanced {
        params {
            filter_profile              = 'balanced'
            canoes_q_some_min           = 65
            canoes_min_size             = 500
            clamms_q_some_min           = 50
            clamms_q_exact_del_min      = 0.0
            clamms_q_exact_dup_min      = -0.5
            xhmm_sq_min                 = 50
            xhmm_ndq_min                = 30
            xhmm_eq_min                 = 30
            xhmm_min_size               = 500
            cnvkit_min_size             = 5000
            cnvkit_min_probes           = 3
            gcnv_qs_del_min             = 100
            gcnv_qs_dup_min             = 50
            gcnv_single_interval_qs_min = 100
            dragen_qual_min             = 30
            dragen_min_bc               = 2
            dragen_min_size             = 5000
            exomedepth_bf_min           = 10.0
            exomedepth_min_size         = 500
        }
    }

    high_precision {
        params {
            filter_profile              = 'high_precision'
            canoes_q_some_min           = 80
            canoes_min_size             = 1000
            clamms_q_some_min           = 100
            clamms_q_exact_del_min      = 0.5
            clamms_q_exact_dup_min      = -0.2
            xhmm_sq_min                 = 60
            xhmm_ndq_min                = 60
            xhmm_eq_min                 = 60
            xhmm_min_size               = 1000
            cnvkit_min_size             = 10000
            cnvkit_min_probes           = 5
            gcnv_qs_del_min             = 400
            gcnv_qs_dup_min             = 400
            gcnv_single_interval_qs_min = 1000
            dragen_qual_min             = 50
            dragen_min_bc               = 3
            dragen_min_size             = 10000
            exomedepth_bf_min           = 30.0
            exomedepth_min_size         = 1000
        }
    }

    max_sensitivity {
        params {
            filter_profile              = 'max_sensitivity'
            canoes_q_some_min           = 50
            canoes_min_size             = 0
            clamms_q_some_min           = 30
            clamms_q_exact_del_min      = -1.0
            clamms_q_exact_dup_min      = -1.0
            xhmm_sq_min                 = 30
            xhmm_ndq_min                = 0
            xhmm_eq_min                 = 0
            xhmm_min_size               = 0
            cnvkit_min_size             = 1000
            cnvkit_min_probes           = 2
            gcnv_qs_del_min             = 50
            gcnv_qs_dup_min             = 20
            gcnv_single_interval_qs_min = 50
            dragen_qual_min             = 20
            dragen_min_bc               = 1
            dragen_min_size             = 2000
            exomedepth_bf_min           = 5.0
            exomedepth_min_size         = 0
        }
    }

    'default' {
        params {
            filter_profile              = 'balanced'
            canoes_q_some_min           = 65
            canoes_min_size             = 500
            clamms_q_some_min           = 50
            clamms_q_exact_del_min      = 0.0
            clamms_q_exact_dup_min      = -0.5
            xhmm_sq_min                 = 50
            xhmm_ndq_min                = 30
            xhmm_eq_min                 = 30
            xhmm_min_size               = 500
            cnvkit_min_size             = 5000
            cnvkit_min_probes           = 3
            gcnv_qs_del_min             = 100
            gcnv_qs_dup_min             = 50
            gcnv_single_interval_qs_min = 100
            dragen_qual_min             = 30
            dragen_min_bc               = 2
            dragen_min_size             = 5000
            exomedepth_bf_min           = 10.0
            exomedepth_min_size         = 500
        }
    }

    // ---------------------------------------------------------------------------------
    // COHORT-SIZE PROFILES
    // Use one of these alongside the executor profile (e.g. -profile wits,small).
    // They tune queueSize, submission rate, per-process concurrency, and batch sizes
    // so that the scheduler is not overwhelmed at small scale or under-utilised at
    // large scale.
    // ---------------------------------------------------------------------------------

    // small – up to ~50 samples (scaled up to ≤100 to keep cohort size 90 in one batch)
    // Low concurrency avoids flooding the scheduler with short-lived jobs.
    small {
        executor.queueSize       = 100
        executor.submitRateLimit = '5/1sec'
        process.maxForks         = 25
        params {
            canoes_batch_size = 50    // single bedtools multicov batch for ≤100 BAMs
            xhmm_batch_size   = 25    // single GATK DepthOfCoverage batch for ≤100 BAMs
        }
    }

    // medium – 50–300 samples (default behaviour)
    // Matches the global defaults; made explicit so it can be named on the command line.
    medium {
        executor.queueSize       = 250
        executor.submitRateLimit = '5/1sec'
        process.maxForks         = 100
        params {
            canoes_batch_size = 100  // single batch for ≤300 samples
            xhmm_batch_size   = 50   // single batch for ≤300 samples
        }
    }

    // large – 300–2000 samples
    // Higher queue and submission limits; bigger batches keep per-chromosome job
    // counts manageable; cohort-level GATK/gCNV steps get extra memory/CPUs.
    large {
        executor.queueSize       = 2000
        executor.submitRateLimit = '20/1sec'
        process.maxForks         = 200
        params {
            canoes_batch_size = 200  // 10 batches per chromosome for 2000 samples
            xhmm_batch_size   = 100  // 20 GATK DOC batches for 2000 samples
        }
        process {
            withLabel: 'gatk' {
                memory = 32.GB
                cpus   = 8
            }
            withLabel: 'large_mem' {
                memory = 128.GB
                cpus   = 16
            }
            withLabel: 'gpu_or_high_cpu' {
                memory = 64.GB
                cpus   = 32
            }
        }
    }

    // ---------------------------------------------------------------------------------
    // wits_gpu – GPU-accelerated profile for NVIDIA L4 nodes on ZA-Wits-Core
    //
    // Use alongside the `wits` profile to enable Parabricks-accelerated alignment
    // and variant calling on the GPU-equipped worker nodes (e.g. n16.core.wits.ac.za):
    //
    //   nextflow run main.nf -profile wits,wits_gpu -params-file params/general/params-canoes.json
    //
    // GPU jobs are submitted to nodes that carry NVIDIA L4 or Tesla K20Xm hardware
    // using the --gres=gpu:1 SLURM generic resource request together with the
    // --reservation=gpu reservation maintained by the Wits HPC team.
    //
    // This profile only overrides the RUN_PARABRICKS process.  All other processes
    // continue to run on CPU nodes as directed by the wits profile.
    // ---------------------------------------------------------------------------------
    wits_gpu {
        process {
            withName: 'RUN_PARABRICKS' {
                // Request one GPU via SLURM's generic resource (gres) mechanism and
                // target the dedicated GPU reservation on the Wits cluster.
                clusterOptions = '--gres=gpu:1 --reservation=gpu'
                container      = 'docker://nvcr.io/nvidia/clara/clara-parabricks:4.0.1-1'
                // Parabricks requires substantial CPU and RAM to stage data while the
                // GPU accelerates alignment.  These defaults match the Wits L4 nodes.
                memory         = '32 GB'
                cpus           = 16
                time           = '24h'
            }
        }
    }
}

// =====================================================================================
// REPORTING
// =====================================================================================
trace {
    enabled   = true
    overwrite = true
    file      = "${launchDir}/exec_reports/${params.workflow}_trace.txt"
}
timeline {
    enabled   = true
    overwrite = true
    file      = "${launchDir}/exec_reports/${params.workflow}_timeline.html"
}
report {
    enabled   = true
    overwrite = true
    file      = "${launchDir}/exec_reports/${params.workflow}_report.html"
}
dag {
    enabled   = true
    overwrite = true
    file      = "${launchDir}/exec_reports/${params.workflow}_dag.html"
}

manifest {
    name            = 'CNV-Caller-Combiner'
    author          = 'Yonatan Ariel Wolberg'
    homePage        = 'https://github.com/Yonatan-Ariel-Wolberg/CNV-Caller-Combiner'
    description     = 'Consensus and ML-based calling pipeline for Copy Number Variations (CNVs) from Exome Sequencing data'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=22.10.0'
    version         = '1.0.0'
}

