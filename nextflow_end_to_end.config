/**
 * Purpose: Nextflow End-to-End pipeline configuration script configuring execution profiles, Apptainer settings, container caches, and process-specific registry container paths.
 * Author/Context: CNV-Caller-Combiner Nextflow Pipeline
 * Configuration Sections:
 *   - Apptainer Container Execution and Caching
 *   - Docker Disabling Configurations
 *   - Process-specific Labels and Containers (SURVIVOR, bcftools, bedtools, AnnotSV)
 */


// Apptainer configuration for containerized // =====================================================================
// PROCESS DEFINITIONS
// =====================================================================
process execution
apptainer {
  enabled = true           // Enable Apptainer container execution
  autoMounts = true        // Auto-mount standard system paths inside the containers
  cacheDir = "${projectDir}/.apptainer-cache" // Directory to cache downloaded container images
}

// Disable Docker to avoid conflicts when Apptainer is the chosen engine
docker {
  enabled = false
}

// Process-specific configurations, registry paths, and execution settings
process {
  // Label-based container matching: maps generic software requirements to biocontainers
  withLabel: 'survivor' {
    container = 'docker://quay.io/biocontainers/survivor:1.0.6--h6bb024c_0'
  }
  
  withLabel: 'bcftools' {
    container = 'docker://quay.io/biocontainers/bcftools:1.23.1--hb2cee57_0'
  }

  // Explicit configuration for exome-coverage processes by process name
  withName: 'RUN_MOSDEPTH' {
    container = 'docker://quay.io/biocontainers/mosdepth:0.3.14--h05c3d44_0'
  }

  withName: 'BUILD_CONSENSUS' {
    container = 'docker://quay.io/biocontainers/bedtools:2.27.1--h077b44d_9'
  }

  // Local executor configuration for downloading the AnnotSV database
  withName: 'DOWNLOAD_ANNOTSV_DB' {
    executor = 'local'
  }

  // Configuration for annotating structural/CNV variants using AnnotSV
  withName: 'runAnnotSV' {
    // Select container dynamically based on target version parameters
    container        = { (params.get('annotsv_version', '3.5.10') ?: '3.5.10').startsWith('3.5') ? 'docker://quay.io/biocontainers/annotsv:3.5.10--hdfd78af_0' : 'docker://quay.io/biocontainers/annotsv:3.4.6--py313hdfd78af_0' }
    // Bind mount database directory to the container if provided in the parameters
    containerOptions = { params.get('annotsv_db', false) ? "-B ${params.annotsv_db}:${params.annotsv_db}" : "" }
  }
}

