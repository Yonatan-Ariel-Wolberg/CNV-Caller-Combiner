# ==============================================================================
# Apptainer/Singularity Definition File: icav2.def
# Description: Installs the Illumina Connected Analytics v2 (ICAv2) CLI 2.43.0.
#              This recipe uses Ubuntu 24.04 as a bootstrap base.
# ==============================================================================

Bootstrap: docker
From: ubuntu:24.04

%labels
    software="icav2-cli"
    software.version="2.43.0"
    about.summary="Illumina Connected Analytics v2 Command Line Interface"
    about.home="https://help.ica.illumina.com/command-line-interface"
    about.license="Proprietary/Illumina"
    about.tags="genomics, cloud, illumina"

%environment
    export DEBIAN_FRONTEND=noninteractive
    export LANG=C.UTF-8
    export LC_ALL=C.UTF-8

%post
    # 1. Install system dependencies
    export DEBIAN_FRONTEND=noninteractive
    apt-get update && apt-get install -y --no-install-recommends curl jq ca-certificates unzip
    
    # 2. Download and extract the official CLI zip file
    curl -fsSL "https://stratus-documentation-us-east-1-public.s3.amazonaws.com/cli/2.43.0/ica-linux-amd64.zip" -o /tmp/ica.zip
    unzip /tmp/ica.zip -d /tmp
    
    # 3. Rename to 'icav2' and make executable
    mv /tmp/linux-amd64/icav2 /usr/local/bin/icav2
    chmod 0755 /usr/local/bin/icav2
    
    # 4. Clean up temporary files, installers and package caches to minimize image size
    rm -rf /tmp/ica.zip /tmp/linux-amd64
    apt-get clean
    rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*